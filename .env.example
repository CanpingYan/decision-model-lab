# 复制为 .env 后按需填写。修改配置后重启服务。
LAB_PORT=8765
LAB_DATA_DIR=.lab-data
API_TIMEOUT=120

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# TypeSafe JEV
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-1.14.0

# 阿里云百炼。选择完整 System One HTTPS 端点，或填写业务空间 ID 和地域。
ALIBABA_API_KEY=
ALIBABA_MODEL=decision-model-preview
ALIBABA_ENDPOINT=
ALIBABA_WORKSPACE_ID=
ALIBABA_REGION=cn-beijing

# Laya 本地工作进程
LAYA_MODEL_ID=convaiinnovations/laya-multilingual
LAYA_REVISION=92d22143468d8af669dc1a5a0480a2b21b4fe56e
LAYA_MODEL_DIR=.runtime/models/laya-multilingual
LAYA_PYTHON=.runtime/laya-venv/bin/python
LAYA_DEVICE=auto
LAYA_DTYPE=float32
LAYA_TIMEOUT=300

# Chinese Decision 本地工作进程
CHINESE_MODEL_ID=quincyqiang/chinese-decision-0.8b
CHINESE_REVISION=f40e4bbdc96fda656221d156a5c7fd9c6788090c
CHINESE_MODEL_DIR=.runtime/models/chinese-decision-0.8b
CHINESE_PYTHON=.runtime/chinese-venv/bin/python
CHINESE_DEVICE=auto
CHINESE_DTYPE=float32
CHINESE_CPU_THREADS=4
CHINESE_TIMEOUT=300
